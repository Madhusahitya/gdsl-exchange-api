apiVersion: v1
kind: Secret
metadata:
  name: gdsl-exchange-api-secret
  namespace: default
  labels:
    app.kubernetes.io/name: gdsl-exchange-api
    app.kubernetes.io/component: backend
type: Opaque
stringData:
  # PostgreSQL Connection URL
  DATABASE_URL: "postgresql://postgres:YOUR_DB_PASSWORD@postgres-service:5432/cryptoflow?schema=public"

  # JWT & Session Secrets (Generate: openssl rand -hex 32)
  JWT_SECRET: "YOUR_32_CHAR_JWT_SECRET_HERE_1234567890"
  JWT_REFRESH_SECRET: "YOUR_32_CHAR_REFRESH_SECRET_HERE_1234567890"
  NEXTAUTH_SECRET: "YOUR_32_CHAR_NEXTAUTH_SECRET_HERE_1234567890"

  # Wallet & DB Encryption Key (64 hex characters / 32 bytes)
  ENCRYPTION_KEY: "YOUR_64_HEX_CHAR_ENCRYPTION_KEY_HERE_12345678901234567890123456789012"
  WALLET_ENCRYPTION_KEY: "YOUR_64_HEX_CHAR_ENCRYPTION_KEY_HERE_12345678901234567890123456789012"

  # Optional Integration Secrets
  BINANCE_API_KEY: ""
  BINANCE_API_SECRET: ""
  NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID: ""
  SENTRY_DSN: ""
