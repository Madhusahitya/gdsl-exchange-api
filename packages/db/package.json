{
  "name": "@cryptoflow/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "push": "dotenv -e ../../.env -- prisma db push",
    "seed": "dotenv -e ../../.env -- ts-node --transpile-only seed.ts",
    "seed:strategies": "dotenv -e ../../.env -- ts-node --transpile-only seedStrategiesOnly.ts",
    "reset:paper": "dotenv -e ../../.env -- ts-node --transpile-only scripts/resetPaperState.ts",
    "purge:losing-trades": "dotenv -e ../../.env -- ts-node --transpile-only scripts/purgeLosingTrades.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only seedStrategiesOnly.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
