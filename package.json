{
  "name": "gdsl-exchange-api",
  "version": "1.0.0",
  "private": true,
  "description": "Godslandx / koie.fin trading API — standalone backend (Express + Socket.IO + Prisma)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && tsx watch src/index.ts",
    "dev:api": "npm run build:packages && tsx watch src/server.ts",
    "dev:socket": "npm run build:packages && tsx watch src/socket.ts",
    "dev:trading": "npm run build:packages && tsx watch src/tradingEngine.ts",
    "dev:worker": "npm run build:packages && tsx watch src/worker.ts",
    "dev:all": "npm run dev",
    "benchmark": "tsx scripts/benchmark-test.ts",
    "build": "npm run build:packages && tsc",
    "build:packages": "npm run build -w @cryptoflow/db && npm run build -w @cryptoflow/binance-executor && npm run build -w @cryptoflow/dex-pancake && npm run build -w @cryptoflow/bot",
    "start": "node dist/index.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:studio": "npm run studio --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "lint": "eslint src packages --max-warnings 0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@cryptoflow/binance-executor": "*",
    "@cryptoflow/bot": "*",
    "@cryptoflow/db": "*",
    "@cryptoflow/dex-pancake": "*",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "onnxruntime-node": "^1.20.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "resend": "^6.12.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.10.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.14",
    "eslint": "^10.2.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.1"
  }
}
