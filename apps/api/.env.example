# =============================================================================
# API environment — copy this file to: apps/api/.env
# =============================================================================
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cryptoflow
JWT_SECRET=your-jwt-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-or-omit
FRONTEND_URL=http://localhost:3000
ENCRYPTION_KEY=your-32-byte-hex-or-long-secret

# --- Binance (Spot). Per-user keys use the Exchange UI; env keys are optional fallbacks. ---
# Mainnet default: https://api.binance.com — for Spot TESTNET keys from testnet.binance.vision use:
# BINANCE_BASE_URL=https://testnet.binance.vision
# --- Binance spot demo executor (npm run demo:trade from repo root) ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# DEMO_MODE=true
# BINANCE_ESTIMATED_TAKER_BPS=10

# --- 1inch Classic (DEX 1inch terminal — separate from PancakeSwap) ---
# Get a key at https://portal.1inch.dev
# ONEINCH_API_KEY=

# --- Jupiter / Solana (DEX Jupiter terminal — separate from BSC) ---
# JUPITER_API_KEY=   # https://portal.jup.ag
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Smart execution router (Binance Spot vs 1inch on DEX 1inch page) ---
# SMART_ROUTER_MAX_BUY_VS_BINANCE_BPS=80
# SMART_ROUTER_MIN_USDT=50
# SMART_ROUTER_BINANCE_TAKER_FEE_BPS=10
# SMART_ROUTER_DEX_GAS_USD_BUY=0.12
# SMART_ROUTER_DEX_GAS_USD_SELL=0.1

# --- BSC / PancakeSwap (@cryptoflow/bot pancakeswapExecutor + executeUnifiedTrade) ---
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# PANCAKESWAP_ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E
# WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
# DEFAULT_CHAIN=BSC
# MAX_SLIPPAGE_BPS=100
# MAX_SLIPPAGE=0.01
# PANCAKE_MIN_OUTPUT_HUMAN=1
# BSC_TRADER_PRIVATE_KEY=
# HOT_WALLET_PRIVATE_KEY=
# (delegated API caps: ../../scripts/hot-wallet.env.snippet)

# --- Internal operator seed (seedInternalUsers.ts) — set on server only, never commit ---
# SEED_PASSWORD_godsland100=
# SEED_PASSWORD_godsland101=
